{
  "name": "@deepseek-ai/dsh-x-feed",
  "description": "Thin X insight feed for DSH: delivery receipt from dsh-cron terminal events, Telegram reply feedback, and local save list over the mature Python X pipeline",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "python/browser_start.py",
    "python/insight_engine.py",
    "python/x_browser.py",
    "python/x_explorer.py",
    "python/x_insight_pipeline.py",
    "python/x_neighborhood.py",
    "python/x_paths.py",
    "python/x_timeline_collector.py",
    "python/x_timeline_dedup.py",
    "python/x_timeline_migrate_explore.py",
    "python/x_timeline_store.py",
    "python/x_topic_search.py",
    "prompts/*.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-cron": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-telegram-gateway": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-cron": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-telegram-gateway": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
