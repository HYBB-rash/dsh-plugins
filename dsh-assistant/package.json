{
  "name": "@deepseek-ai/dsh-assistant",
  "description": "Private assistant responsibilities for DSH: one user focus, concurrent Telegram delegations/monitors, progress outbox, Web observation",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-assistant-migrate-to-v4": "lib/migrate-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./migrate": {
      "types": "./lib/types/migrate-cli.d.ts",
      "default": "./lib/migrate-cli.js"
    },
    "./historical-recovery": {
      "types": "./lib/types/historical-recovery.d.ts",
      "default": "./lib/historical-recovery.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-cron": "*",
    "@deepseek-ai/dsh-telegram-gateway": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-cron": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tool-subagent-report": "*",
    "@deepseek-ai/dsh-telegram-gateway": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
