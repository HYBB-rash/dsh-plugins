{
  "name": "@herman/personal-feed",
  "description": "Source-neutral Personal Feed v2 business scope runtime",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ]
}
