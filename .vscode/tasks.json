{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DSH: Install Web Plugins (official npm)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dsh-web-install-plugins",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "DSH: Start Web (installed runtime)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dsh-web-runtime",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
