# syntax=docker/dockerfile:1
FROM docker.io/library/node:24.13.0-bookworm-slim@sha256:46feb5752989c05b8606e6323fbbc3db667d14ade1c24f5d0d44d9ca9909d607

COPY release-system/release/workspace-runtime-requirements.lock /opt/dsh/workspace-runtime-requirements.lock

# Keep the numeric identity aligned with the host mount while also making the
# container's passwd home authoritative.  HOME alone is insufficient because
# OpenSSH resolves its default ~/.ssh paths from the passwd database.
RUN /usr/sbin/usermod --login herman --home /home/herman --move-home node \
 && /usr/sbin/groupmod --new-name herman node

ENV DEBIAN_FRONTEND=noninteractive \
    CI=1 \
    DSH_HOME=/home/herman/.dsh \
    DSH_CWD=/home/herman/.dsh/workspace \
    HOME=/home/herman \
    TZ=Asia/Shanghai \
    PATH=/opt/dsh/harness/node_modules/.bin:/usr/local/bin:/usr/bin:/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash bluez build-essential ca-certificates curl git iproute2 iputils-ping \
      jq less netcat-openbsd openssh-client openssl procps python3 python3-pip \
      ripgrep rsync socat sqlite3 tini util-linux xz-utils zstd \
 && python3 -m pip install --break-system-packages --no-cache-dir \
      --requirement /opt/dsh/workspace-runtime-requirements.lock \
 && npm install --global pnpm@11.7.0 \
 && rm -rf /var/lib/apt/lists/* /opt/dsh/workspace-runtime-requirements.lock

# Source identities are declared after the expensive, source-independent OS
# layer so ordinary plugin releases do not reinstall the whole toolchain.
ARG DSH_HARNESS_COMMIT
ARG DSH_HARNESS_PATCH_SHA256

WORKDIR /opt/dsh
COPY harness/ /opt/dsh/harness/

# Dependency metadata is copied before frequently changing source.  A normal
# plugin release can therefore reuse the dependency and Harness build layers.
RUN mkdir -p \
      /opt/dsh/harness/local-plugins/telegram-gateway \
      /opt/dsh/harness/local-plugins/dsh-cron \
      /opt/dsh/harness/local-plugins/dsh-assistant \
      /opt/dsh/harness/local-plugins/personal-feed-selector \
      /opt/dsh/harness/local-plugins/personal-feed \
      /opt/dsh/harness/local-plugins/x-feed \
      /opt/dsh/harness/local-profiles/web \
      /opt/dsh/harness/local-profiles/telegram \
      /opt/dsh/harness/local-profiles/telegram-test
COPY plugins/telegram-gateway/package.json /opt/dsh/harness/local-plugins/telegram-gateway/package.json
COPY plugins/dsh-cron/package.json /opt/dsh/harness/local-plugins/dsh-cron/package.json
COPY plugins/dsh-assistant/package.json /opt/dsh/harness/local-plugins/dsh-assistant/package.json
COPY plugins/personal-feed-selector/package.json /opt/dsh/harness/local-plugins/personal-feed-selector/package.json
COPY plugins/personal-feed/package.json /opt/dsh/harness/local-plugins/personal-feed/package.json
COPY plugins/x-feed/package.json /opt/dsh/harness/local-plugins/x-feed/package.json
COPY release-system/release/profiles/web/package.json /opt/dsh/harness/local-profiles/web/package.json
COPY release-system/release/profiles/telegram/package.json /opt/dsh/harness/local-profiles/telegram/package.json
COPY release-system/release/profiles/telegram-test/package.json /opt/dsh/harness/local-profiles/telegram-test/package.json
RUN sed -i '/^packages:$/a\  - local-profiles/*\n  - local-plugins/*' /opt/dsh/harness/pnpm-workspace.yaml

WORKDIR /opt/dsh/harness
ENV DSH_CLIENT_COMMIT_HASH=${DSH_HARNESS_COMMIT}
RUN pnpm install --no-frozen-lockfile \
 && pnpm run build

COPY plugins/ /opt/dsh/plugins-src/
COPY release-system/release/ /opt/dsh/release-system/
RUN set -eu; \
    for package in telegram-gateway dsh-cron dsh-assistant personal-feed-selector personal-feed x-feed; do \
      cp -a "/opt/dsh/plugins-src/$package/." "/opt/dsh/harness/local-plugins/$package/"; \
    done; \
    cp -a /opt/dsh/release-system/profiles/. /opt/dsh/harness/local-profiles/; \
    cp /opt/dsh/release-system/vitest.external.config.ts /opt/dsh/harness/vitest.external.config.ts; \
    cp /opt/dsh/plugins-src/runtime-package-topology.json /opt/dsh/harness/local-plugins/runtime-package-topology.json; \
    mkdir -p /opt/dsh/harness/local-plugins/scripts; \
    cp /opt/dsh/plugins-src/scripts/materialize-runtime-topology.mjs \
      /opt/dsh/harness/local-plugins/scripts/materialize-runtime-topology.mjs; \
    for package in telegram-gateway dsh-cron dsh-assistant personal-feed-selector personal-feed x-feed; do \
      (cd "local-plugins/$package" \
       && pnpm exec tsc -b \
       && pnpm exec tsdown \
       && pnpm exec tsc -b); \
    done

RUN mkdir -p /home/herman/.dsh /home/herman/.dsh/workspace \
 && chown -R 1000:1000 /home/herman

# Tests run with the same unprivileged identity as the final container.  Among
# other things, this keeps permission-failure tests honest (root can bypass a
# directory's write bits).
USER 1000:1000

RUN set -eu; \
    for package in telegram-gateway dsh-cron dsh-assistant personal-feed-selector personal-feed x-feed; do \
      if [ -d "local-plugins/$package/tests" ]; then \
        (cd "local-plugins/$package"; \
         config=vitest.config.ts; \
         if [ ! -f "$config" ]; then config=/opt/dsh/harness/vitest.external.config.ts; fi; \
         DSH_HARNESS_ROOT=/opt/dsh/harness \
            node /opt/dsh/harness/node_modules/vitest/vitest.mjs run \
              --config "$config" --configLoader runner \
              --maxWorkers=1 --no-file-parallelism); \
      fi; \
    done; \
    python_data="$(mktemp -d)"; \
    trap 'rm -rf "$python_data"' EXIT; \
    (cd local-plugins/x-feed/python \
     && DSH_X_FEED_DATA_DIR="$python_data" PYTHONWARNINGS=ignore \
        python3 -m unittest discover -p 'test_x_*.py' \
     && DSH_X_FEED_DATA_DIR="$python_data" PYTHONWARNINGS=ignore \
        python3 -m unittest test_insight_engine.py); \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/test_workspace_migration.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/credential-notion.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/notion-page-check.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/notion-automation-entrypoint.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/harness-notion-automation-probe.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/harness-notion-automation-runner.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/harness-notion-automation-bridge.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/harness-notion-automation-status.py; \
    bash /opt/dsh/release-system/tests/harness-notion-automation-command.sh; \
    bash /opt/dsh/release-system/tests/engine-lock.sh; \
    bash /opt/dsh/release-system/tests/production-operation-lock.sh; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/notion-inbox-init.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/notion-https-compat.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/test_scrub_preflight_state.py; \
    PYTHONDONTWRITEBYTECODE=1 \
      python3 /opt/dsh/release-system/tests/test_workspace_migration_content.py; \
    node --test /opt/dsh/release-system/tests/assistant-cron-health.mjs; \
    node --test /opt/dsh/release-system/tests/fake-notion.mjs; \
    node --test /opt/dsh/release-system/tests/notion-retry-binding.mjs; \
    node --test /opt/dsh/release-system/tests/inspect-cron-reanchor.mjs; \
    NODE_NO_WARNINGS=1 node /opt/dsh/release-system/tests/validate-assistant-state.mjs

ARG DSH_PLUGINS_COMMIT
ARG DSH_RELEASE_COMMIT
LABEL org.opencontainers.image.title="DSH private-assistant runtime" \
      org.opencontainers.image.revision="${DSH_PLUGINS_COMMIT}" \
      io.dsh.release.revision="${DSH_RELEASE_COMMIT}" \
      io.dsh.harness.revision="${DSH_HARNESS_COMMIT}" \
      io.dsh.harness.patch-sha256="${DSH_HARNESS_PATCH_SHA256}"

WORKDIR /home/herman/.dsh/workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/dsh/release-system/scripts/entrypoint.sh"]
CMD ["help"]
