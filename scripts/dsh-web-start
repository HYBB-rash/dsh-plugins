#!/usr/bin/env bash
set -euo pipefail
umask 077
script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
package_root=${DSH_WEB_PACKAGE_ROOT:-$script_directory}
release="$package_root/current"
if [[ -f "$script_directory/../config/web.patch.yml" ]]; then release=$(cd "$script_directory/.." && pwd); fi
export DSH_HOME=${DSH_HOME:-$HOME/.dsh}
export DSH_CWD=${DSH_CWD:-$DSH_HOME/workspace}
export DSH_WEB_HOME="$DSH_HOME"
export DSH_WEB_PUBLIC_ORIGIN=${DSH_WEB_PUBLIC_ORIGIN:-https://dsh.man-her.icu}
export DSH_REMOTE_PUBLIC_BASE_URL=${DSH_REMOTE_PUBLIC_BASE_URL:-$DSH_WEB_PUBLIC_ORIGIN}
export DSH_WEB_HOST=${DSH_WEB_HOST:-0.0.0.0}
export DSH_WEB_PORT=${DSH_WEB_PORT:-3080}
for argument in "$@"; do
  case "$argument" in
    --host|--host=*|--port|--port=*) echo 'set DSH_WEB_HOST / DSH_WEB_PORT for this deployment entry' >&2; exit 1 ;;
  esac
done
for file in "$release/bin/web" "$release/bin/dsh" "$release/config/remote.patch.yml" "$release/scripts/dsh-web-notify-start-url.mjs" "$DSH_HOME/runtime/package-lock.json"; do
  [[ -f "$file" ]] || { echo "missing installed input: $file; install separately first" >&2; exit 1; }
done
# Keep all launch inputs in the selected release, even if current later changes.
release=$(cd -- "$release" && pwd -P)
# A restart never unpacks, installs, rewrites Profile, or chooses a new version.
"$release/bin/dsh" --version >/dev/null
export DSH_WEB_NOTIFY_START_URL=1
# The published remote plugin's LAN path uses webserver config, not --host:
# the official CLI deliberately refuses an explicit --host 0.0.0.0.
# Remote devices use its paired /remote channel, not globally trusted /api.
setsid "$release/bin/web" --patch "$release/config/remote.patch.yml" --port "$DSH_WEB_PORT" --no-open "$@" &
web_pid=$!
stop_children() {
  trap - INT TERM
  kill -- "-$web_pid" 2>/dev/null || true
  wait "$web_pid" 2>/dev/null || true
}
trap 'stop_children; exit 143' INT TERM
set +e
wait "$web_pid"
status=$?
set -e
stop_children
exit "$status"
