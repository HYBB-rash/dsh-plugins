#!/usr/bin/env bash
set -euo pipefail
umask 077
script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
package_root=${DSH_WEB_PACKAGE_ROOT:-$script_directory}
release="$package_root/current"
if [[ -f "$script_directory/../config/web.patch.yml" ]]; then release=$(cd "$script_directory/.." && pwd); fi
export DSH_HOME=${DSH_HOME:-$HOME/.dsh}
export DSH_CWD=${DSH_CWD:-$DSH_HOME/workspace}
export DSH_WEB_HOME="$DSH_HOME"
export DSH_WEB_PUBLIC_ORIGIN=${DSH_WEB_PUBLIC_ORIGIN:-https://dsh.man-her.icu}
host=${DSH_WEB_HOST:-127.0.0.1}
port=${DSH_WEB_PORT:-3080}
lan_address=${DSH_LAN_ADDRESS:-192.168.6.240}
public_authority=${DSH_WEB_PUBLIC_AUTHORITY:-dsh.man-her.icu}
for file in "$release/bin/web" "$release/bin/dsh" "$release/scripts/dsh-web-lan-proxy.mjs" "$release/scripts/dsh-web-notify-start-url.mjs" "$DSH_HOME/runtime/package-lock.json"; do
  [[ -f "$file" ]] || { echo "missing installed input: $file; install separately first" >&2; exit 1; }
done
# Node resolves module URLs to real paths; the proxy's entry-point check must
# receive that same path rather than the mutable current symlink.
release=$(cd -- "$release" && pwd -P)
# A restart never unpacks, installs, rewrites Profile, or chooses a new version.
"$release/bin/dsh" --version >/dev/null
export DSH_WEB_NOTIFY_START_URL=1
setsid "$release/bin/web" --host "$host" --port "$port" --no-open "$@" \
  --trusted-host "$lan_address" "$public_authority" &
web_pid=$!
node "$release/scripts/dsh-web-lan-proxy.mjs" &
proxy_pid=$!
stop_children() {
  trap - INT TERM
  kill -- "-$web_pid" "$proxy_pid" 2>/dev/null || true
  wait "$web_pid" "$proxy_pid" 2>/dev/null || true
}
trap 'stop_children; exit 143' INT TERM
set +e
wait -n "$web_pid" "$proxy_pid"
status=$?
set -e
stop_children
exit "$status"
