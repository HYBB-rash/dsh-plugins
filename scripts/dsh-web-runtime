#!/usr/bin/env bash
set -euo pipefail

package_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ -d "$package_root/upstream/deepseek-harness" ]]; then
  export DSH_HOME="${DSH_WEB_HOME:-$package_root/.dsh-web}"
  harness_root="$package_root/upstream/deepseek-harness"
  patch="$package_root/config/web/portable.patch.yml"
  default_port=5080
else
  : "${DSH_HOME:?set DSH_HOME to an external writable directory}"
  harness_root="$package_root/harness"
  patch="$package_root/config/web.patch.yml"
fi

if ! command -v node >/dev/null 2>&1; then
  echo 'node is required to run DSH Web' >&2
  exit 127
fi

runtime_args=("$@")
if [[ -n "${default_port:-}" ]]; then
  add_default_port=true
  for argument in "${runtime_args[@]}"; do
    if [[ "$argument" == --port || "$argument" == --port=* \
      || "$argument" == --dump-config || "$argument" == --dump-default-config ]]; then
      add_default_port=false
      break
    fi
  done
  if [[ "$add_default_port" == true ]]; then
    runtime_args+=(--port "$default_port")
  fi
fi

exec node --expose-internals "$harness_root/apps/cli/lib/bin.js" \
  --profile web \
  --patch "$patch" \
  "${runtime_args[@]}"
