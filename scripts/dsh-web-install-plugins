#!/usr/bin/env bash
set -euo pipefail

package_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

if [[ -d "$package_root/upstream/deepseek-harness" ]]; then
  export DSH_HOME="${DSH_WEB_HOME:-$package_root/.dsh-web}"
  harness_root="$package_root/upstream/deepseek-harness"
  harness_node_modules="$harness_root/node_modules/.pnpm/node_modules"
  harness_tsc="$harness_root/node_modules/.bin/tsc"
  harness_tsdown="$harness_root/node_modules/.bin/tsdown"
  plugin_node_modules="$package_root/.dsh-plugin-node_modules"
  pnpm_bin="$plugin_node_modules/.pnpm-bin"

  prepare_pnpm_shim() {
    local package_manager
    package_manager=$(node -p 'require(process.argv[1]).packageManager' "$harness_root/package.json")
    if [[ ! "$package_manager" =~ ^pnpm@[0-9][0-9A-Za-z.+-]*$ ]]; then
      echo "unsupported Harness packageManager: $package_manager" >&2
      return 1
    fi
    rm -rf "$pnpm_bin"
    mkdir -p "$pnpm_bin"
    printf '#!/usr/bin/env bash\nexec corepack %q "$@"\n' "$package_manager" >"$pnpm_bin/pnpm"
    chmod +x "$pnpm_bin/pnpm"
  }

  build_fs_ext() {
    local fs_ext_directories=(
      "$harness_root"/node_modules/.pnpm/fs-ext@*/node_modules/fs-ext
    )
    if [[ ${#fs_ext_directories[@]} -ne 1 || ! -d "${fs_ext_directories[0]}" ]]; then
      echo 'expected exactly one installed fs-ext package' >&2
      return 1
    fi
    (cd "${fs_ext_directories[0]}" && npm run install)
  }

  link_dependency_tree() {
    local source=$1
    local entry name scope_entry
    while IFS= read -r -d '' entry; do
      name=${entry##*/}
      [[ "$name" == .* ]] && continue
      if [[ "$name" == @* && -d "$entry" ]]; then
        mkdir -p "$plugin_node_modules/$name"
        while IFS= read -r -d '' scope_entry; do
          rm -rf "$plugin_node_modules/$name/${scope_entry##*/}"
          ln -s "$scope_entry" "$plugin_node_modules/$name/${scope_entry##*/}"
        done < <(find "$entry" -mindepth 1 -maxdepth 1 -print0)
      else
        rm -rf "$plugin_node_modules/$name"
        ln -s "$entry" "$plugin_node_modules/$name"
      fi
    done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
  }

  prepare_plugin_node_modules() {
    rm -rf "$plugin_node_modules"
    mkdir -p "$plugin_node_modules"
    link_dependency_tree "$harness_root/node_modules"
    link_dependency_tree "$harness_node_modules"
  }

  ensure_local_plugin_link() {
    local plugin=$1
    local target="$package_root/$plugin"
    local package_name package_basename link
    package_name=$(node -p 'require(process.argv[1]).name' "$target/package.json")
    if [[ "$package_name" != @deepseek-ai/* || "${package_name#@deepseek-ai/}" == */* ]]; then
      echo "unsupported local plugin package name: $package_name" >&2
      return 1
    fi
    package_basename=${package_name#@deepseek-ai/}
    link="$plugin_node_modules/@deepseek-ai/$package_basename"
    mkdir -p "$plugin_node_modules/@deepseek-ai"
    rm -rf "$link"
    ln -s "$target" "$link"
  }

  build_plugin() {
    local plugin_directory=$1
    local existing
    existing=$(readlink "$plugin_directory/node_modules" 2>/dev/null || true)
    if [[ "$existing" != "$plugin_node_modules" ]]; then
      if [[ -e "$plugin_directory/node_modules" || -L "$plugin_directory/node_modules" ]]; then
        if [[ ! -L "$plugin_directory/node_modules" ]]; then
          echo "$plugin_directory/node_modules is not a symlink; refusing to overwrite" >&2
          return 1
        fi
        rm -f "$plugin_directory/node_modules"
      fi
      ln -s "$plugin_node_modules" "$plugin_directory/node_modules"
    fi

    rm -rf "$plugin_directory/lib" "$plugin_directory/tsconfig.tsbuildinfo"
    (cd "$plugin_directory" && "$harness_tsc" -b)
    (cd "$plugin_directory" && "$harness_tsdown")
    (cd "$plugin_directory" && "$harness_tsc" -b)
    if [[ ! -f "$plugin_directory/lib/index.js" ]]; then
      echo "missing $plugin_directory/lib/index.js after build" >&2
      return 1
    fi
  }

  prepare_pnpm_shim
  (
    cd "$harness_root"
    export PATH="$pnpm_bin:$PATH"
    pnpm install --ignore-scripts
    build_fs_ext
    pnpm run build
  )
  prepare_plugin_node_modules
  for plugin in telegram-gateway dsh-cron dsh-assistant; do
    ensure_local_plugin_link "$plugin"
    build_plugin "$package_root/$plugin"
  done

  installed_packages=()
  for package in \
    @deepseek-ai/dsh-telegram-gateway \
    @deepseek-ai/dsh-cron \
    @deepseek-ai/dsh-assistant; do
    installed="$DSH_HOME/profiles/web/node_modules/$package"
    if [[ -e "$installed" || -L "$installed" ]]; then
      installed_packages+=("$package")
    fi
  done
  if [[ ${#installed_packages[@]} -gt 0 ]]; then
    node "$harness_root/apps/cli/lib/bin.js" \
      plugin --profile web remove "${installed_packages[@]}"
  fi

  exec node "$harness_root/apps/cli/lib/bin.js" \
    plugin --profile web add --ignore-scripts --force \
    "file:$package_root/telegram-gateway" \
    "file:$package_root/dsh-cron" \
    "file:$package_root/dsh-assistant"
fi

: "${DSH_HOME:?set DSH_HOME to an external writable directory}"
if ! command -v node >/dev/null 2>&1; then
  echo 'node is required to install DSH plugins' >&2
  exit 127
fi
if ! command -v pnpm >/dev/null 2>&1; then
  echo 'pnpm is required to install DSH plugins' >&2
  exit 127
fi

credentials_root="$package_root/production-credentials"
for credential_file in \
  "$credentials_root/.credentials.yaml" \
  "$credentials_root/secrets/notion.token"; do
  if [[ ! -f "$credential_file" || -L "$credential_file" ]]; then
    echo "missing regular bundled production credential: $credential_file" >&2
    exit 1
  fi
done

plugin_archives=()
for pattern in \
  'deepseek-ai-dsh-telegram-gateway-*.tgz' \
  'deepseek-ai-dsh-cron-*.tgz' \
  'deepseek-ai-dsh-assistant-*.tgz'; do
  matches=("$package_root"/plugins/$pattern)
  if [[ ${#matches[@]} -ne 1 || ! -f "${matches[0]}" ]]; then
    echo "expected exactly one $pattern under $package_root/plugins" >&2
    exit 1
  fi
  plugin_archives+=("${matches[0]}")
done

node "$package_root/harness/apps/cli/lib/bin.js" \
  plugin --profile web add --ignore-scripts "${plugin_archives[@]}"

install -d -m 0700 "$DSH_HOME" "$DSH_HOME/secrets"
install -m 0600 "$credentials_root/.credentials.yaml" "$DSH_HOME/.credentials.yaml"
install -m 0600 "$credentials_root/secrets/notion.token" "$DSH_HOME/secrets/notion.token"
