#!/usr/bin/env bash
set -euo pipefail
umask 077
package_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export DSH_HOME=${DSH_WEB_HOME:-${DSH_HOME:-$package_root/.dsh-web}}
export DSH_WEB_HOME="$DSH_HOME"
for argument in "$@"; do
  [[ "$argument" == --migrate ]] || { echo 'usage: dsh-web-install-plugins [--migrate]' >&2; exit 2; }
done
mkdir -p "$DSH_HOME"
exec 9>"$DSH_HOME/.web-runtime.lock"
flock -n 9 || { echo 'dsh web: stop this DSH_HOME runtime before installation' >&2; exit 1; }
if [[ -f "$package_root/runtime/package-lock.json" ]]; then
  exec node "$package_root/scripts/lib/web-package.mjs" install "$@"
fi
work=$(mktemp -d /tmp/dsh-web-install.XXXXXX)
cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT
node "$package_root/scripts/lib/web-package.mjs" prepare "$work/dsh-web"
node "$work/dsh-web/scripts/lib/web-package.mjs" install "$@"
